# Supabase (or any Postgres) connection strings.
# In Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL uses the pooled "Transaction" connection (port 6543).
# DIRECT_URL uses the direct connection (port 5432) - needed for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Any long random string - used to sign login session cookies.
SESSION_SECRET="change-this-to-a-long-random-string"

# Used once by `npm run seed` to create the first payroll-clerk (admin) login.
# Change the password after first login if possible, or re-run seed with a new value.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="חשבת שכר"
